{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assistant Vol Drone",
  "version": "0.1.0",
  "identifier": "fr.mgi.assistantvoldrone",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Assistant Vol Drone",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
